# Copy to .env and edit. Never commit the real .env file.
PORT=3000
NODE_ENV=development
# SQLite database file (created automatically, migrations run on start)
DB_PATH=./data/restaurant.db
# Folder for admin-uploaded food images
UPLOAD_DIR=./public/uploads
# Used only by `npm run seed` to create the first admin account.
# If ADMIN_PASSWORD is empty, a random password is generated and printed once.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Set to true when served over HTTPS (adds the Secure flag to the session cookie)
COOKIE_SECURE=false
# Set to true ONLY when running behind your own reverse proxy (Nginx/Caddy) so rate limits use the real client IP
TRUST_PROXY=false
